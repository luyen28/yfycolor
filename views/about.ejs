<%- include('partials/header') %>

<section class="page-hero">
  <div class="wrap">
    <span class="stamp"><%= t.about.stamp %></span>
    <h1><%- t.about.h1 %></h1>
  </div>
</section>

<section class="section about-banner">
  <div class="wrap">
    <img src="/images/about-hero.svg" alt="<%= t.about.stamp %>" loading="lazy">
  </div>
</section>

<section class="section about-body">
  <div class="wrap about-grid">
    <div class="about-text">
      <h2><%= t.about.storyTitle %> <%= t.company.shortName %></h2>
      <p class="legal-name-line"><%= t.company.legalName %></p>
      <p><%= t.about.p1.replace('{company}', t.company.shortName) %></p>
      <p><%= t.about.p2 %></p>
      <div class="about-values">
        <% t.about.values.forEach(function(v){ %>
          <div class="value-item">
            <h3><%= v.title %></h3>
            <p><%= v.text %></p>
          </div>
        <% }); %>
      </div>
    </div>
    <aside class="about-facts">
      <% t.about.facts.forEach(function(f){ %>
        <div class="fact-card">
          <h4><%= f.title %></h4>
          <p><%= f.text %></p>
        </div>
      <% }); %>
    </aside>
  </div>
</section>

<section class="section cta-band">
  <div class="wrap cta-band-inner">
    <h2><%= t.about.ctaTitle %></h2>
    <p><%= t.about.ctaText %></p>
    <a href="/lien-he" class="btn btn-primary"><%= t.about.ctaBtn %></a>
  </div>
</section>

<%- include('partials/footer') %>
